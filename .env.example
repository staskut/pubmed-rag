# NCBI Entrez — an email is required by NCBI's usage policy; the API key is optional
# but raises the rate limit from 3 to 10 requests/sec. Get one at:
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_EMAIL=you@example.com
NCBI_API_KEY=
NCBI_TOOL=pubmed-rag

# Corpus definition (PubMed search syntax). Override to change what gets ingested.
PUBMED_QUERY=(Anesthesia[MeSH] OR Anesthetics[MeSH] OR Analgesia[MeSH])
PUBMED_DATE_FROM=2015
PUBMED_DATE_TO=2025
# Cap total articles fetched (0 = no cap). Keeps first runs cheap.
PUBMED_MAX_ARTICLES=200

# OpenAI (used later for embeddings + generation, not for corpus build)
OPENAI_API_KEY=

# Postgres knowledge base (docker-compose). Host connections use POSTGRES_PORT.
POSTGRES_USER=pubmed
POSTGRES_PASSWORD=pubmed
POSTGRES_DB=pubmed
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Grafana monitoring
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
